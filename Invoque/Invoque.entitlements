<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- JavaScriptCore is the command runtime; under Hardened Runtime it
	     needs this entitlement to use its JIT instead of running every
	     command and filter keystroke interpreter-only. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
